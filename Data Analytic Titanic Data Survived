      "source": [
        "import seaborn as sns\n",
        "import pandas as pd\n",
        "import matplotlib.pyplot as plt\n",
        "df_titanic = sns.load_dataset('titanic')\n",
        "display(df_titanic.head())\n",
        "print(df_titanic.info())\n",
        "avg_age_by_gender = df_titanic.groupby('sex')['age'].mean()\n",
        "print(avg_age_by_gender)\n",
        "survival_rete_by_gender = df_titanic.groupby('class')['survived'].mean()\n",
        "print(survival_rete_by_gender)\n",
        "survival_rate = df_titanic.groupby(['sex','class'])['survived'].mean()\n",
        "print(survival_rate)\n",
        "agg_stats = df_titanic.groupby('class').agg({\n",
        "    \"age\":[\"mean\",\"median\"],\n",
        "    \"fare\":[\"mean\",\"max\"]\n",
        "    })\n",
        "print(agg_stats)\n",
        "sorted_age = df_titanic.sort_values('age')\n",
        "print(sorted_age.head())\n",
        "sorted_fare = df_titanic.sort_values(\"fare\", ascending=False)\n",
        "print(sorted_fare.head())\n",
        "df_indexed = df_titanic.set_index('who')\n",
        "print(df_indexed.head())\n",
        "print(df_indexed.loc['man'].head())\n",
        "print(df_indexed.loc['woman'].head())\n",
        "print(df_indexed.loc['child'].head())\n",
        "#Histogram of passenger ages\n",
        "sns.histplot(df_titanic['age'], bins=20, kde=True)\n",
        "plt.title(\"Age Distribution of Titanic Passenger\")\n",
        "plt.xlabel(\"Age\")\n",
        "plt.ylabel(\"Count\")\n",
        "plt.show()\n",
        "# Survival rate by passenger class\n",
        "survival_rate_by_class = df_titanic.groupby(\"class\")[\"survived\"].mean().reset_index()\n",
        "sns.barplot(x=\"class\", y=\"survived\", data=survival_rate_by_class)\n",
        "plt.title(\"Survival Rate by Passenger Class\")\n",
        "plt.ylabel(\"Survival Rate\")\n",
        "plt.show()\n"
      ],
